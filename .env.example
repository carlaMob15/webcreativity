# environment variables for emailJS
# used on contact component
NEXT_PUBLIC_EMAILJS_SERVICE_ID=          # service_sdks9sz
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=         # template_cds32d
NEXT_PUBLIC_EMAILJS_PUBLIC_USER_ID=      # scd8nSBV8d00sdcDF

# Sanity CMS (portfolio content)
# Used by lib/sanity.js and sanity.config.js. Fallbacks in code: projectId dvy4l5vj, dataset production.
NEXT_PUBLIC_SANITY_PROJECT_ID=          # e.g. dvy4l5vj
NEXT_PUBLIC_SANITY_DATASET=             # e.g. production

# Sanity webhook: set in Sanity project → API → Webhooks. URL: https://YOUR_DOMAIN/api/revalidate?secret=YOUR_SECRET
# Request body (JSON): { "slug": "project-slug", "_type": "project" } (slug optional for non-project types)
SANITY_REVALIDATE_SECRET=               # create a random string; use same value in webhook URL